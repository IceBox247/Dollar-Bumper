# ─────────────────────────────────────────────────────────────
#  Dollar Bumper — environment configuration
#  Copy this file to `.env` and fill in real values.
#  NEVER commit your real .env (it holds private keys & tokens).
# ─────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token-here

# Optional but recommended: your bot's @username WITHOUT the @ (e.g. dollarbumperbot).
# When set, the Mini App builds referral links without a live getMe call on every
# cold start — a little faster and one less thing that can hiccup.
BOT_USERNAME=

# Comma-separated Telegram user IDs that get admin powers
ADMIN_IDS=8015817816

# Public @username or numeric -100... id of the proof/payments channel.
# The bot must be an ADMIN in this channel to post.
PROOF_CHANNEL_ID=@dollarbumperpayout

# Channels users must join before using the bot (optional).
# Comma-separated @usernames. Leave empty to disable the gate.
REQUIRED_CHANNELS=@dollarbumper

# ── Blockchain (BNB Smart Chain / BEP20) ─────────────────────
# BSC RPC endpoint (public default works; use a paid node for scale)
BSC_RPC_URL=https://bsc-dataseed.binance.org

# USDT (BEP20) contract on BSC — 18 decimals. This is the real mainnet address.
USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# Hot wallet that PAYS OUT user withdrawals. Fund it with USDT + BNB (for gas).
# Keep only what you can afford to expose; sweep excess to cold storage.
PAYOUT_WALLET_ADDRESS=0xYourHotWalletAddress
PAYOUT_WALLET_PRIVATE_KEY=0xYourHotWalletPrivateKey

# Wallet that RECEIVES advertiser payments (can be cold storage — no key needed here)
PROJECT_WALLET_ADDRESS=0xYourProjectReceivingWallet

# ── Economics (all amounts in USDT) ──────────────────────────
REFERRAL_REWARD=0.01
MIN_WITHDRAWAL=1.0
# Withdrawals at or above this (USDT) require admin review before payout
REVIEW_THRESHOLD=5.0
# Minimum advertiser spend to feature a channel
MIN_CAMPAIGN_BUDGET=10.0
# Share of an advertiser's payment that funds tasker rewards.
# 0.40 = 40% to taskers, 60% platform fee. Accepts 0.40 or 40.
ADVERTISER_REWARD_POOL_PCT=0.40

# Anti multi-account: flag an account when this many OTHER accounts already
# share its IP. 2 = allow up to 2 accounts per IP, flag the 3rd+.
IP_FLAG_THRESHOLD=2

# ── Games & Points ("Bumps") ─────────────────────────────────
POINTS_PER_USDT=10000        # 10,000 Bumps = 1 USDT
MIN_POINTS_CONVERT=1000      # minimum Bumps before you can convert
SPIN_COOLDOWN_HOURS=12       # free Lucky Wheel spin every N hours
SPIN_REWARDS=5,10,15,20,5,10 # possible Bumps per spin (comma-separated)
AD_REWARD_ADSGRAM=15         # Bumps per Adsgram ad
AD_REWARD_MONETAG=5          # Bumps per Monetag ad
AD_DAILY_ADSGRAM=4           # Adsgram ads per day
AD_DAILY_MONETAG=3           # Monetag ads per day
GAME_REWARD_CAP=23           # max Bumps per arcade-game round
GAME_DAILY_PLAYS=5           # paid arcade rounds per day (anti-farm)
GAME_ADS_PER_PLAY=1          # ads a user watches before each round

# ── Social handles ───────────────────────────────────────────
SOCIAL_REWARD_POINTS=25          # Bumps awarded once per social platform linked
REQUIRE_SOCIAL_FOR_OFFSITE=true  # require a linked social before off-Telegram tasks

# ── Ad networks (paste your IDs; blank disables that network) ─
ADSGRAM_BLOCK_ID=            # Adsgram Block ID, e.g. int-12345
MONETAG_ZONE_ID=             # Monetag Zone/Tag id (digits)

# ── Storage ───────────────────────────────────────────────────
# Local / always-on hosts: SQLite is fine.
# Vercel / serverless: use Postgres (Neon, Supabase, Vercel Postgres), e.g.
#   postgresql+asyncpg://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///data/dollar_bumper.db

# ── Webhook / serverless (Vercel) ────────────────────────────
# Your deployment's base URL (no trailing slash), used by scripts/set_webhook.py
PUBLIC_BASE_URL=https://your-app.vercel.app
# A random string Telegram echoes back so only Telegram can call your webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Set the SAME value as Vercel's CRON_SECRET env var to protect /api/cron
CRON_SECRET=

# ── Chain explorer (for proof links) ─────────────────────────
EXPLORER_TX_URL=https://bscscan.com/tx/
